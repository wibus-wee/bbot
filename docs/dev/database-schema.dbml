enum run_event_type {
  "run.queued"
  "run.started"
  "run.progress"
  "run.completed"
  "run.failed"
  "run.canceled"
  "tool.executed"
}

enum run_status {
  queued
  running
  succeeded
  failed
  canceled
}

enum session_entry_kind {
  message
  action
  result
  summary
  system
}

enum tool_execution_status {
  succeeded
  failed
}

enum workspace_session_status {
  active
  archived
}

table run_events {
  id text [pk, not null]
  run_id text [not null]
  type run_event_type [not null]
  message text [not null]
  payload jsonb
  timestamp "timestamp with time zone" [not null, default: `now()`]
}

table runs {
  id text [pk, not null]
  session_id text [not null]
  prompt text [not null]
  status run_status [not null, default: 'queued']
  summary text
  error text
  started_at "timestamp with time zone"
  finished_at "timestamp with time zone"
  created_at "timestamp with time zone" [not null, default: `now()`]
  updated_at "timestamp with time zone" [not null, default: `now()`]
}

table session_entries {
  id text [pk, not null]
  session_id text [not null]
  run_id text
  kind session_entry_kind [not null]
  payload jsonb [not null]
  search_text text
  sequence bigserial [not null, increment]
  timestamp "timestamp with time zone" [not null, default: `now()`]

  indexes {
    (session_id, sequence) [name: 'session_entries_session_sequence_idx']
    (run_id, sequence) [name: 'session_entries_run_sequence_idx']
  }
}

table system_configs {
  id text [pk, not null]
  key varchar(200) [not null]
  value jsonb [not null]
  created_at "timestamp with time zone" [not null, default: `now()`]
  updated_at "timestamp with time zone" [not null, default: `now()`]

  indexes {
    key [name: 'system_configs_key_unique', unique]
  }
}

table tool_executions {
  id text [pk, not null]
  run_id text [not null]
  tool text [not null]
  input jsonb [not null]
  output jsonb [not null]
  status tool_execution_status [not null, default: 'succeeded']
  error text
  started_at "timestamp with time zone" [not null, default: `now()`]
  ended_at "timestamp with time zone"
}

table workspace_sessions {
  id text [pk, not null]
  name varchar(200) [not null]
  root_path text
  telegram_chat_id text
  telegram_user_id text
  forked_from_session_id text
  status workspace_session_status [not null, default: 'active']
  metadata jsonb
  agent_settings jsonb
  accessed_at "timestamp with time zone" [not null, default: `now()`]
  created_at "timestamp with time zone" [not null, default: `now()`]
  updated_at "timestamp with time zone" [not null, default: `now()`]

  indexes {
    (telegram_chat_id, telegram_user_id) [name: 'workspace_sessions_chat_user_idx']
    forked_from_session_id [name: 'workspace_sessions_forked_from_idx']
    
  }
}