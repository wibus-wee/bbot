{
  "name": "@bbot/omnicore",
  "private": true,
  "version": "0.0.0",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "require": "./src/index.ts"
    }
  },
  "bin": {
    "bbot": "bin/bbot.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check-types": "tsc -p tsconfig.json --noEmit",
    "dev:adapter": "tsx src/entry/cli-adapter.ts",
    "dev:kernel": "tsx src/entry/cli.ts kernel",
    "dev:supervisor": "OMNICORE_KERNEL_CMD=pnpm OMNICORE_KERNEL_ARGS='--filter @bbot/omnicore dev:kernel' tsx src/entry/cli.ts supervisor",
    "dev:config": "tsx src/entry/cli.ts config",
    "adapter": "node dist/entry/cli-adapter.js",
    "kernel": "node dist/entry/cli.js kernel",
    "supervisor": "node dist/entry/cli.js supervisor",
    "config": "node dist/entry/cli.js config"
  },
  "dependencies": {
    "@bbot/agent": "workspace:^",
    "@bbot/shared": "workspace:^",
    "@mariozechner/pi-agent-core": "^0.52.9",
    "@mariozechner/pi-ai": "^0.52.9",
    "@inquirer/prompts": "^7.8.3",
    "better-sqlite3": "^11.10.0",
    "commander": "^14.0.0",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "@bbot/typescript-config": "workspace:*",
    "@types/better-sqlite3": "^7.6.12",
    "@types/ws": "^8.18.1",
    "tsx": "^4.21.0"
  }
}
