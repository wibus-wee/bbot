{
  "name": "@bbot/core-daemon",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "NODE_ENV=production node dist/main.js",
    "openapi:generate": "tsx dev/openapi.ts",
    "check-types": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@bbot/agent": "workspace:^",
    "@bbot/database": "workspace:^",
    "@bbot/protocol": "workspace:^",
    "@elysiajs/bearer": "^1.4.1",
    "@elysiajs/openapi": "^1.4.1",
    "@elysiajs/node": "^1.4.4",
    "@sinclair/typebox": "^0.34.48",
    "drizzle-orm": "^0.45.1",
    "elysia": "^1.4.24",
    "openapi-types": "^12.1.3",
    "p-queue": "^8.1.0",
    "zod": "^4.3.6",
    "@bbot/shared": "workspace:^"
  },
  "devDependencies": {
    "@bbot/typescript-config": "workspace:^",
    "@types/node": "^22.15.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "yaml": "^2.8.1",
    "vitest": "^4.0.18"
  }
}
